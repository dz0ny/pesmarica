# The boot splash, in plymouth's own scripting language.
#
# Two settled lines and a third that breathes: the mark says "songbook", and
# the breathing says "alive", which is the whole reason this exists. The panel
# is black from power-on until flutter-pi draws its first frame, and a black
# screen means "booting", "running" and "dead" indistinguishably -- which cost
# an afternoon of looking for a fault that was not there.
#
# Nothing here draws text: the theme is two PNGs and a sine. A theme that
# needed a typeface would need plymouth's label plugin, and the point of this
# one is to cost the card as little as a picture can.

Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);

mark = Image("mark.png");
line = Image("line.png");

# The mark is drawn large and scaled down, so it lands on a 1080p panel and a
# small one at the same share of the width rather than the same pixel count.
scale = Window.GetWidth() * 0.30 / mark.GetWidth();
mark = mark.Scale(mark.GetWidth() * scale, mark.GetHeight() * scale);
line = line.Scale(line.GetWidth() * scale, line.GetHeight() * scale);

left = (Window.GetWidth() - mark.GetWidth()) / 2;
top = (Window.GetHeight() - mark.GetHeight()) / 2;

marks = Sprite(mark);
marks.SetPosition(left, top, 0);

# The third bar sits in the row the mark leaves empty for it.
lines = Sprite(line);
lines.SetPosition(left, top + mark.GetHeight() - line.GetHeight(), 1);

# Plymouth refreshes at 50 Hz, so this is a breath of about three seconds.
frame = 0;

fun refresh() {
        frame = frame + 1;
        lines.SetOpacity(0.55 + 0.45 * Math.Cos(frame * 6.2831853 / 150));
}

Plymouth.SetRefreshFunction(refresh);
