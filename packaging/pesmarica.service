[Unit]
Description=Pesmarica digital signage
After=systemd-user-sessions.service network-online.target
Wants=network-online.target

[Service]
# flutter-pi draws straight to KMS/DRM, so it needs a free VT and access to
# /dev/dri and the input devices. Group membership does the job without root.
Type=simple
User=pesmarica
SupplementaryGroups=video render input tty
Environment=PESMARICA_CONTENT=/var/lib/pesmarica
WorkingDirectory=/opt/pesmarica
ExecStart=/usr/local/bin/flutter-pi --release /opt/pesmarica/bundle

# The screen must come back on its own after a power blip or a crash.
Restart=always
RestartSec=3

StandardInput=tty
StandardOutput=journal
StandardError=journal
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes

[Install]
WantedBy=multi-user.target
