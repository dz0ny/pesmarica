# Pesmarica signage appliance -- Raspberry Pi Zero 2 W, 64-bit.
#
# Derived from buildroot's raspberrypizero2w_64_defconfig, plus mesa/vc4,
# systemd, flutter-pi and the app bundle overlay.

BR2_aarch64=y
BR2_cortex_a53=y
BR2_ARM_FPU_VFPV4=y
BR2_TOOLCHAIN_EXTERNAL=y
BR2_TOOLCHAIN_EXTERNAL_BOOTLIN=y
BR2_TOOLCHAIN_EXTERNAL_BOOTLIN_AARCH64_GLIBC_STABLE=y

BR2_GLOBAL_PATCH_DIR="board/raspberrypi/patches"

# System
BR2_TARGET_GENERIC_HOSTNAME="pesmarica"
BR2_TARGET_GENERIC_ISSUE="Pesmarica signage"
BR2_INIT_SYSTEMD=y
BR2_TARGET_GENERIC_GETTY_PORT=""
BR2_SYSTEM_ENABLE_NLS=y
BR2_TARGET_LOCALE_PURGE=y
BR2_TARGET_LOCALE_WHITELIST="C en_US"
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_PESMARICA_PATH)/board/pesmarica/rootfs-overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_PESMARICA_PATH)/board/pesmarica/post-build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_PESMARICA_PATH)/board/pesmarica/post-image.sh"

# Kernel: Raspberry Pi fork, bcm2711 defconfig covers the Zero 2 W in 64-bit.
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_TARBALL=y
BR2_LINUX_KERNEL_CUSTOM_TARBALL_LOCATION="$(call github,raspberrypi,linux,21b410140c47ffab5668399f6f143c7d7b935c8b)/linux-21b410140c47ffab5668399f6f143c7d7b935c8b.tar.gz"
BR2_LINUX_KERNEL_DEFCONFIG="bcm2711"
BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_INTREE_DTS_NAME="broadcom/bcm2710-rpi-zero-2-w"
BR2_LINUX_KERNEL_DTB_OVERLAY_SUPPORT=y
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y

# Firmware / bootloader
BR2_PACKAGE_RPI_FIRMWARE=y
BR2_PACKAGE_RPI_FIRMWARE_BOOTCODE_BIN=y
BR2_PACKAGE_RPI_FIRMWARE_VARIANT_PI=y
BR2_PACKAGE_RPI_FIRMWARE_CONFIG_FILE="$(BR2_EXTERNAL_PESMARICA_PATH)/board/pesmarica/config.txt"
BR2_PACKAGE_RPI_FIRMWARE_CMDLINE_FILE="$(BR2_EXTERNAL_PESMARICA_PATH)/board/pesmarica/cmdline.txt"
BR2_PACKAGE_RPI_FIRMWARE_INSTALL_DTB_OVERLAYS=y
BR2_PACKAGE_KMOD=y
BR2_PACKAGE_KMOD_TOOLS=y

# Graphics: VideoCore IV. vc4 gallium only -- the Zero 2 W has no v3d block
# separate from vc4, and llvmpipe would drag in LLVM for nothing.
BR2_PACKAGE_MESA3D=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_VC4=y
BR2_PACKAGE_MESA3D_GBM=y
BR2_PACKAGE_MESA3D_OPENGL_EGL=y
BR2_PACKAGE_MESA3D_OPENGL_ES=y

# The app
BR2_PACKAGE_FLUTTERPI=y

# Wifi. The Zero 2 W has no ethernet, and this box is always the access point:
# people connect *to* it to reach the web interface. It never joins a network,
# so there is no wpa_supplicant here and no credentials to leak.
BR2_PACKAGE_HOSTAPD=y
BR2_PACKAGE_HOSTAPD_DRIVER_NL80211=y
BR2_PACKAGE_HOSTAPD_WPA3=y
BR2_PACKAGE_DNSMASQ=y
BR2_PACKAGE_BRCMFMAC_SDIO_FIRMWARE_RPI=y
BR2_PACKAGE_BRCMFMAC_SDIO_FIRMWARE_RPI_WIFI=y
BR2_PACKAGE_SYSTEMD_NETWORKD=y
BR2_PACKAGE_SYSTEMD_RESOLVED=y
# No timesyncd: nothing to sync against on an isolated network.

# Handy on an appliance you cannot plug a keyboard into
BR2_PACKAGE_OPENSSH=y
BR2_PACKAGE_RSYNC=y

BR2_PACKAGE_BUSYBOX_SHOW_OTHERS=y
BR2_PACKAGE_XZ=y

# Images
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_SIZE="480M"
# BR2_TARGET_ROOTFS_TAR is not set
BR2_PACKAGE_HOST_DOSFSTOOLS=y
BR2_PACKAGE_HOST_GENIMAGE=y
BR2_PACKAGE_HOST_KMOD_XZ=y
BR2_PACKAGE_HOST_MTOOLS=y
