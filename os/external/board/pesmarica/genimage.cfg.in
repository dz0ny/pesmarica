image boot.vfat {
	vfat {
		files = {
#BOOT_FILES#
		}
	}
	size = 48M
}

# A separate ext4 for the songbook. The web UI writes pages at runtime and
# they must survive re-flashing the rootfs.
image data.ext4 {
	ext4 {
		label = "pesmarica-data"
		use-mke2fs = true
	}
	size = 256M
}

image sdcard.img {
	hdimage {
	}

	partition boot {
		partition-type = 0xC
		bootable = "true"
		image = "boot.vfat"
	}

	partition rootfs {
		partition-type = 0x83
		image = "rootfs.ext4"
	}

	partition data {
		partition-type = 0x83
		image = "data.ext4"
	}
}
