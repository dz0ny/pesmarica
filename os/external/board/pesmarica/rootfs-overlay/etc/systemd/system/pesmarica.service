[Unit]
Description=Pesmarica digital signage
# No network dependency: the songbook renders from local content, the web UI
# can come up whenever wifi does. Waiting for it would add seconds to blank screen.
After=var-lib-pesmarica.mount systemd-tmpfiles-setup.service
Requires=var-lib-pesmarica.mount

[Service]
Type=simple
Environment=PESMARICA_CONTENT=/var/lib/pesmarica
WorkingDirectory=/opt/pesmarica
ExecStart=/usr/bin/flutter-pi --release /opt/pesmarica/bundle

Restart=always
RestartSec=2

StandardInput=tty
StandardOutput=journal
StandardError=journal
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes

[Install]
WantedBy=multi-user.target
