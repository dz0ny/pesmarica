[Unit]
Description=Pesmarica access point
# The AP is the only way in, so it comes up early and independently of the app.
After=var-lib-pesmarica.mount systemd-tmpfiles-setup.service sys-subsystem-net-devices-wlan0.device
Requires=var-lib-pesmarica.mount
BindsTo=sys-subsystem-net-devices-wlan0.device
Before=systemd-networkd.service

[Service]
Type=simple
ExecStartPre=/usr/lib/pesmarica/ap-preflight
ExecStart=/usr/sbin/hostapd /var/lib/pesmarica/hostapd.conf
ExecReload=/bin/kill -HUP $MAINPID

# Keep trying: a radio that comes up late must not leave the box unreachable.
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
