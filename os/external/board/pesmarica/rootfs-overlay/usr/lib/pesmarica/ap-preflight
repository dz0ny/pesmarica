#!/bin/sh
# Refuses to start hostapd with a config that cannot work, and falls back to
# the shipped default instead.
#
# The web interface validates before it writes, so this is the second line of
# defence: a half-written file after a power cut, a hand-edit over SSH, or a
# future bug. Losing the access point means losing the only way in, so the box
# always comes up on *something*.
set -eu

RUNTIME=/var/lib/pesmarica/hostapd.conf
DEFAULT=/usr/share/pesmarica/hostapd.conf

valid() {
	conf="$1"
	[ -r "$conf" ] || return 1

	ssid=$(sed -n 's/^ssid=//p' "$conf" | head -1)
	# 1..32 bytes, per 802.11.
	[ -n "$ssid" ] || return 1
	[ "$(printf %s "$ssid" | wc -c)" -le 32 ] || return 1

	# Either open, or a WPA passphrase of a length wpa_supplicant will accept.
	if grep -q '^wpa=' "$conf"; then
		psk=$(sed -n 's/^wpa_passphrase=//p' "$conf" | head -1)
		len=$(printf %s "$psk" | wc -c)
		[ "$len" -ge 8 ] && [ "$len" -le 63 ] || return 1
	fi
	return 0
}

if ! valid "$RUNTIME"; then
	echo "pesmarica: $RUNTIME unusable, falling back to the shipped default" >&2
	cp "$DEFAULT" "$RUNTIME"
fi
